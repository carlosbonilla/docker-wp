# Official image versions; override deliberately when upgrading.
WORDPRESS_IMAGE=wordpress:7.1.4-php8.3-apache
MARIADB_IMAGE=mariadb:11.4.13

# Loopback by default. Use the VM address or 0.0.0.0 for trusted LAN access.
WORDPRESS_BIND_ADDRESS=127.0.0.1
WORDPRESS_PORT=8080

# Generate these once per deployment; never commit the real .env.
WORDPRESS_DB_PASSWORD=
MARIADB_ROOT_PASSWORD=
